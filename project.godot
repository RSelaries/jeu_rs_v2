; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="jeu rs v2"
run/main_scene="uid://bua5k5556moc2"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=504
window/size/viewport_height=896
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[editor_plugins]

enabled=PackedStringArray("res://addons/csv_data_importer/plugin.cfg", "res://addons/questions_data/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray"
}

[importer_defaults]

com.timothyqiu.godot-csv-importer={
"delimiter": 0,
"detect_booleans": true,
"detect_numbers": true,
"force_float": false,
"headers": true
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
